{
	admin off
	auto_https off
}

:8080 {
	@authorized {
		header Authorization "Bearer {$MODEL_PROXY_TOKEN}"
		path /api/chat /api/tags
	}

	handle @authorized {
		reverse_proxy ollama:11434 {
			header_up -Authorization
		}
	}

	@valid_token_unknown_path header Authorization "Bearer {$MODEL_PROXY_TOKEN}"
	handle @valid_token_unknown_path {
		respond 404
	}

	handle {
		respond 401
	}

	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Copy this file to .env on the approved GPU host and replace placeholders locally.
# Never commit .env or include its values in logs, screenshots, issues, or documentation.

COMPOSE_PROJECT_NAME=opsmate-model-host

# Opening is refused unless an authorized operator changes this exact value to YES.
OPSMATE_PRIVATE_GPU_APPROVED=NO

# 192.0.2.10 is a documentation-only address. Replace it with the approved VPN IPv4 address.
MODEL_BIND_ADDRESS=192.0.2.10
MODEL_VPN_INTERFACE=replace-with-approved-vpn-interface-name

# Accept one NVIDIA GPU index such as 0 or one full GPU UUID beginning with GPU-.
OPSMATE_GPU_DEVICE_ID=replace-with-one-gpu-index-or-uuid

# Pin the reviewed Ollama image by full sha256 digest.
OLLAMA_IMAGE=ollama/ollama@sha256:replace-with-reviewed-64-hex-image-digest
OLLAMA_KEEP_ALIVE=10m
OPSMATE_LLM_MODEL=replace-with-approved-model:tag
# Exact ID printed by `ollama list` after the approved model review (normally 12 hex characters).
OPSMATE_LLM_MODEL_ID=replace-with-approved-model-id

# Use at least 32 random URL-safe characters. This example is not a credential.
MODEL_PROXY_TOKEN=replace-with-a-long-random-model-proxy-token

CADDY_IMAGE=caddy:2.10.0-alpine@sha256:ae4458638da8e1a91aafffb231c5f8778e964bca650c8a8cb23a7e8ac557aa3c
MODEL_WAIT_SECONDS=180
PROXY_WAIT_SECONDS=60
